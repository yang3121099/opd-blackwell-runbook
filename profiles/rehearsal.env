# [v2.5.9z126] (Fable 11-02 08:1x UTC, item 8) a rehearsal's limits: bootstrap.sh --role rehearsal writes these over the same keys in
# control.env after any --profile (a rehearsal shares the HF account with the next node: about 20 node-side commits an hour).
# The status every 5 min, the pulse every 10 min, receipts / events / procs inside the status commit (z124c's canary); nothing but
# the control plane past 24 commits in the last hour, and no bulk upload or publish at all (headroom 30 of a 30 budget)
export STATUS_PUT_S=300
export PULSE_PUT_S=600
export CONTROL_BATCH=1
export HF_COMMIT_BUDGET=30
export CONTROL_ONLY_AT=24
export BULK_HEADROOM=30

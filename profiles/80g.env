# [v2.5.9z126] (Fable 11-02 08:1x UTC, next_machine_selfserve 2 item 2) the 80 GB class (H800 / A100-80G / H100): what the H800 ran
# with by 11-01 15:56 UTC (its setenv history), written by bootstrap.sh --profile 80g into the node's own control.env at B5. A key
# the node's control.env already holds is kept (setenv wins on a rerun). Every key is a setenv key (scripts/test_profiles.py).
# The arms' numerics as the B300 ran them: flash-attn's venv with remove-padding (venv-fa, built by setup step 4; until it exists
# verify.sh's smoke runs on the main venv through PROBE_ENV), 4 sequences per micro-batch
export VENV=fa
export FIXED_MICRO_BSZ=4
# Memory only, the math unchanged: the log-prob passes one sequence at a time, the rollout's share of the card, gradient checkpointing
export LOGP_MB=1
export VLLM_UTIL=0.35
export GC=1
# The control plane: the 2-minute status (Runming 10-31), results to the public repository (weights / readings / .done), as the H800
# from seq 60
export STATUS_PUT_S=120
export PUBLIC_UPLOADS=1

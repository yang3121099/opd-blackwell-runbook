# [v3.0] (Fable 11-17; Runming: a classmate's 8 x H200, maybe two machines, GitHub mode, "stable, and light on the HF API") one profile
# for an H200 node: bootstrap.sh --profile h200 writes these into the node's control.env (a key already there is kept).
# The arms' numerics as the >= 140 GB class ran them (profiles/140g.env; the 8 x H200s of 11-10 .. 11-12 used it)
export VENV=fa
export FIXED_MICRO_BSZ=4
export GC=0
export LOGP_MB=4
export VLLM_UTIL=0.5
export DISK_ALERT_GB=150
export READINGS_DISK_MIN_GB=150
# Results (weights at the registered steps, readings, .done) to the public repository, as the H800 (80g.env)
export PUBLIC_UPLOADS=1
# Light on the HF API (one account for every node; 10-22 and 11-01: bursts brought 429s and a blind node). Per node and hour: the
# status 12 commits with receipts / events / procs inside it (CONTROL_BATCH), the pulse 6, the hourly resync 1, a running task's
# logs 2 each; past 45 commits in the last hour only the control plane goes on, and a bulk upload needs 10 left of 60. A task's
# .done is looked for in the repository once an hour (was every 10 min per waiting task). A command still runs within a minute of
# its push; its receipt rides the next status commit (<= 5 min; `heartbeat` asks for one now)
export STATUS_PUT_S=300
export PULSE_PUT_S=600
export PROCS_PUT_S=1800
export RUNS_PUT_S=1800
export CONTROL_BATCH=1
export HF_COMMIT_BUDGET=60
export CONTROL_ONLY_AT=45
export BULK_HEADROOM=10
export REMOTE_EVERY=3600
# [v3.1] the machine's rule: every GPU at 85 % or more (about 90 %), else the job is ended after two hours. An idle GPU runs the
# owner's own filler (its command is node-local: bootstrap.sh --fill-cmd), and the node keeps its own record (status.gpu_util)
export GPU_FILL=1
export GPU_UTIL_FLOOR=85
# [v3.11] a borrowed machine may be taken back after about two hours: a resume state every 5 steps (default 25), mirrored to the
# long-term store on a shared disk (env.sh: DR_ROOT = the store). 5 divides 25: the arms' registered steps 25 and 50 are still
# save steps (10 would skip step 25).
export DR_EVERY=5
# [v3.12] (Runming 11-18: "can the 20-30 minutes before the arms start be shortened?") a borrowed machine lives about two hours:
# FAST_START=1 - control/venv_ready as soon as the stack imports, no vLLM tier probe on a Hopper card, no verify.sh, flash-attn's
# wheel and forward / backward test without its smoke, no vision / ifeval environments (scripts/overnight.sh, cold_start.sh,
# fa_probe.sh). DISPATCH_CANARY=none - the queue's first stage is its own gate (queue_h2a: h2g), which the arms depend on.
export FAST_START=1
export DISPATCH_CANARY=none

# [v2.5.9z137] (Fable 11-03 22:3x Beijing, t0_preA1 seq 3+; lab WO-001 11-09: the next machine is self-paid, a single B200 ~180 GB by
# default) the >= 140 GB-per-card class (B200 / B300): the B300's numerics, the memory the card has. bootstrap.sh --profile 140g writes
# these into the node's control.env (a key already there is kept); on a node run by hand, the same export lines go into
# $OPD_ROOT/control.env before setup. Use it alone, not with 80g (80g's GC=1 would be kept first).
export VENV=fa
export FIXED_MICRO_BSZ=4
export GC=0
export LOGP_MB=4
export VLLM_UTIL=0.5
